{
  "$schema": "https://raw.githubusercontent.com/timenco/dialectic-pr/main/config/dialectic-pr-schema.json",
  "model": "claude-opus-4-6",
  "exclude_patterns": [
    "**/*.lock",
    "**/*.min.js",
    "**/*.bundle.js",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/.next/**",
    "**/node_modules/**",
    "**/*.map",
    "**/*.log"
  ],
  "strategies": {
    "small": {
      "maxTokens": 16000
    },
    "medium": {
      "maxTokens": 12000
    },
    "large": {
      "maxTokens": 8000
    },
    "xlarge": {
      "maxTokens": 4000
    }
  }
}
