{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/timenco/dialectic-pr/main/config/dialectic-pr-schema.json",
  "title": "Dialectic PR Configuration",
  "description": "Configuration file for Dialectic PR — AI Code Reviewer for TypeScript Projects",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema URL for editor support"
    },
    "model": {
      "type": "string",
      "description": "Claude model to use for review",
      "default": "claude-opus-4-8",
      "examples": [
        "claude-opus-4-8",
        "claude-sonnet-4-6"
      ]
    },
    "language": {
      "type": "string",
      "description": "Review output language (ISO 639-1 code)",
      "examples": ["en", "ko", "ja", "zh"]
    },
    "exclude_patterns": {
      "type": "array",
      "description": "Glob patterns for files to exclude from review",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "strategies": {
      "type": "object",
      "description": "Token budget per PR size strategy",
      "properties": {
        "small": {
          "type": "object",
          "properties": {
            "maxTokens": { "type": "number" }
          },
          "required": ["maxTokens"]
        },
        "medium": {
          "type": "object",
          "properties": {
            "maxTokens": { "type": "number" }
          },
          "required": ["maxTokens"]
        },
        "large": {
          "type": "object",
          "properties": {
            "maxTokens": { "type": "number" }
          },
          "required": ["maxTokens"]
        },
        "xlarge": {
          "type": "object",
          "properties": {
            "maxTokens": { "type": "number" }
          },
          "required": ["maxTokens"]
        }
      }
    }
  },
  "additionalProperties": false
}
